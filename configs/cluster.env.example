# Optional shell settings for scripts/train.sh. Copy this file to
# configs/cluster.env, customize it, then source configs/cluster.env.

# Use an externally started Ray cluster. Set trainer.nnodes and
# trainer.n_gpus_per_node to match, and mount data, weights, and outputs
# at identical paths on all nodes.
# export RAY_ADDRESS="ray-head.example.org:6379"

# Python in the training environment and, optionally, a shared log path.
# export PYTHON_BIN="/path/to/training-env/bin/python"
# export TENSORBOARD_DIR="/shared/recast/tensorboard"

# Set NCCL_SOCKET_IFNAME and GLOO_SOCKET_IFNAME here if your cluster
# requires a specific network interface.
