include LICENSE NOTICE README.md requirements.txt pyproject.toml .gitignore
recursive-include mesd *.py
recursive-include verl *.py
recursive-include configs *.yaml *.example *.json
recursive-include docs *.md
recursive-include scripts *.py *.sh
recursive-include tools *.py
global-exclude __pycache__ *.py[cod] .DS_Store *.local.env
prune data
prune outputs
prune checkpoints
